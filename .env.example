# ==============================================================================
# RevTech - Environment Variables (12-Factor App)
# ==============================================================================
# Copy to `.env` (git-ignored). Every value below is the default, so the file is
# optional.
#
# Who reads what:
#   - Docker Compose loads `.env` automatically: sections 1 and 2 apply to
#     `mise run db:*` and `mise run app:*`.
#   - Spring Boot does NOT read `.env`. For `mise run dev` / `./mvnw spring-boot:run`,
#     export the section 3 variables in your shell, e.g. `$env:DB_PORT="3307"`.

# ------------------------------------------------------------------------------
# 1. MySQL container (docker-compose.yml)
# ------------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=root_pass
# Host port mapped to MySQL; if you change it, set DB_PORT to match for host runs
MYSQL_PORT=3306

# ------------------------------------------------------------------------------
# 2. Containerized app (docker-compose.full.yml)
# ------------------------------------------------------------------------------
# Host port mapped to the app (inside the container it always listens on 8000)
SERVER_PORT=8000
# Must match the password in infra/mysql/init-databases.sql
DB_PASSWORD=revtech_pass
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4200
# 'false' calls the real MTC service through OpenFeign instead of the in-memory mock
REVTECH_CLIENTS_MOCK=true
CLIENTS_MTC_URL=http://localhost:8089
SPRING_THREADS_VIRTUAL_ENABLED=true

# ------------------------------------------------------------------------------
# 3. Spring Boot on the host (application.properties) - export in your shell
# ------------------------------------------------------------------------------
# Also honored: SERVER_PORT, DB_PASSWORD, CORS_ALLOWED_ORIGINS, REVTECH_CLIENTS_MOCK,
# CLIENTS_MTC_URL and SPRING_THREADS_VIRTUAL_ENABLED from section 2.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=revtech
DB_USER=revtech_user
# Hibernate generates the schema (no migrations yet): update | validate | none
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
# Scalar API portal
SCALAR_ENABLED=true
SCALAR_PATH=/scalar
