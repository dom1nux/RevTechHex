# ==============================================================================
# RevTech - Environment Variables Catalog (12-Factor App)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Global MySQL Database Configuration (MySQL 8.4 LTS)
# ------------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=root_pass
MYSQL_PORT=3306
DB_HOST=localhost
DB_PORT=3306

# Passwords for MySQL Provisioned Users
ADMINISTRATIVA_DB_PASSWORD=administrativa_pass
CITAS_DB_PASSWORD=citas_pass
CLIENTES_DB_PASSWORD=clientes_pass
IDENTIDAD_DB_PASSWORD=identidad_pass
INSPECTION_DB_PASSWORD=inspection_pass
PAGOS_DB_PASSWORD=pagos_pass

# ------------------------------------------------------------------------------
# 2. Microservice & Gateway Ports
# ------------------------------------------------------------------------------
GATEWAY_SERVER_PORT=8000
INSPECTION_SERVER_PORT=8080
CLIENTES_SERVER_PORT=8081
IDENTIDAD_SERVER_PORT=8082

# ------------------------------------------------------------------------------
# 2.1 API Gateway Configuration (Single Entrypoint)
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4200
INSPECTION_SERVICE_URL=http://localhost:8080
CLIENTES_SERVICE_URL=http://localhost:8081
IDENTIDAD_SERVICE_URL=http://localhost:8082

# ------------------------------------------------------------------------------
# 3. Inter-Service Communication (OpenFeign)
# ------------------------------------------------------------------------------
# Set to 'false' to enable live HTTP Feign calls instead of in-memory mocks
REVTECH_CLIENTS_MOCK=true

# Feign Target URLs (use localhost for host runner or service name in Docker Compose)
CLIENTS_MSVC_CLIENTES_URL=http://localhost:8081
CLIENTS_MSVC_IDENTIDAD_URL=http://localhost:8082
CLIENTS_MTC_URL=http://localhost:8089

# ------------------------------------------------------------------------------
# 4. Scalar API Documentation
# ------------------------------------------------------------------------------
SCALAR_ENABLED=true
SCALAR_PATH=/scalar

# ------------------------------------------------------------------------------
# 5. Java 26 Virtual Threads (Project Loom)
# ------------------------------------------------------------------------------
SPRING_THREADS_VIRTUAL_ENABLED=true
